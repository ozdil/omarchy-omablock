#!/usr/bin/python3
# OmaBlock Official Privileged Hosts Sync Helper (ozdil.omablock)
# OMABLOCK_HELPER_SIGNATURE = "7f8b9e6a-omablock-hosts-sync-helper-v1"
"""
OmaBlock Hosts Sync Helper
Safely and atomically modifies /etc/hosts to apply or remove OmaBlock sinkhole rules.
Adheres strictly to the Omarchy Security Guide:
- Strict regex validation on domain entries (no shell injection, no arbitrary host overrides).
- Preserves all pre-existing system and user hosts entries.
- Atomic file replacement via os.replace to prevent race conditions or partial writes.
- Automatic DNS cache flush via resolvectl.
"""

import os
import re
import sys
import shutil
import subprocess

HOSTS_PATH = "/etc/hosts"
BACKUP_PATH = "/etc/hosts.omablock.bak"
TEMP_PATH = "/etc/hosts.omablock.tmp"

BEGIN_MARKER = "# --- BEGIN OMABLOCK MANAGED RULES ---"
END_MARKER = "# --- END OMABLOCK MANAGED RULES ---"
BANNER_COMMENT = (
    "# Managed automatically by OmaBlock (ozdil.omablock). Do not edit inside this block."
)

# RFC 1035 strict domain regex: labels 1-63 chars starting/ending with alphanumeric, separated by single dots
DOMAIN_REGEX = re.compile(
    r"^(?!-)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
)


POLICY_DIRS = [
    "/etc/opt/chrome/policies/managed",
    "/etc/chromium/policies/managed",
    "/etc/brave/policies/managed",
    "/etc/edge/policies/managed",
]
POLICY_FILENAME = "omablock_policies.json"
POLICY_MARKER = '"_omablock_managed": true'
POLICY_CONTENT = (
    '{"_omablock_managed": true, "DnsOverHttpsMode": "off", "QuicAllowed": false, '
    '"ExtensionInstallForcelist": ["cjpalhdlnbpafiamejdnhcphjbkeiagm;https://clients2.google.com/service/update2/crx"]}\n'
)

DOH_DOMAINS = {
    "use-application-dns.net",
    "dns.google",
    "dns.google.com",
    "cloudflare-dns.com",
    "chrome.cloudflare-dns.com",
    "mozilla.cloudflare-dns.com",
    "1dot1dot1dot1.cloudflare-dns.com",
    "dns.quad9.net",
    "doh.opendns.com",
    "dns.adguard-dns.com",
    "doh.cleanbrowsing.org",
    "dns.nextdns.io",
    "doh.applied-privacy.net",
    "dnsforge.de",
    "doh.mullvad.net",
    "doh.controld.com",
    "dns.alidns.com",
    "doh.pub",
    "dns.sb",
}


def apply_browser_doh_policy():
    """Enforces DnsOverHttpsMode: 'off' in browser enterprise policies so browsers cannot bypass /etc/hosts via DoH.
    Never overwrites pre-existing policies not created and owned by OmaBlock."""
    for pdir in POLICY_DIRS:
        parent = os.path.dirname(pdir)
        if (os.path.exists(parent) and not os.path.islink(parent)) or (os.path.exists(pdir) and not os.path.islink(pdir)):
            try:
                target = os.path.join(pdir, POLICY_FILENAME)
                if os.path.exists(target):
                    if os.path.islink(target):
                        continue
                    try:
                        with open(target, "r", encoding="utf-8") as existing_f:
                            existing_content = existing_f.read(1024)
                            if POLICY_MARKER not in existing_content:
                                # Preserve existing user policy; do not overwrite
                                continue
                    except Exception:
                        continue

                os.makedirs(pdir, mode=0o755, exist_ok=True)
                tmp = target + ".tmp"
                flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0)
                fd = os.open(tmp, flags, 0o644)
                with open(fd, "w", encoding="utf-8") as f:
                    f.write(POLICY_CONTENT)
                os.chmod(tmp, 0o644)
                os.replace(tmp, target)
            except Exception as e:
                print(f"Warning: Could not write browser DoH policy in {pdir}: {e}", file=sys.stderr)


def clear_browser_doh_policy():
    """Removes OmaBlock DoH policy strictly if created and owned by OmaBlock."""
    for pdir in POLICY_DIRS:
        target = os.path.join(pdir, POLICY_FILENAME)
        if os.path.exists(target) and not os.path.islink(target):
            try:
                with open(target, "r", encoding="utf-8") as f:
                    content = f.read(1024)
                    if POLICY_MARKER not in content:
                        # Not an OmaBlock managed policy, preserve it
                        continue
                os.unlink(target)
            except Exception:
                pass


def flush_dns_cache():
    """Flushes systemd-resolved DNS cache if available."""
    try:
        subprocess.run(
            ["resolvectl", "flush-caches"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=10,
        )
    except Exception:
        pass


def strip_omablock_block(content: str) -> str:
    """Removes any existing OmaBlock block from hosts content."""
    lines = content.splitlines()
    out = []
    in_block = False

    for line in lines:
        if BEGIN_MARKER in line:
            in_block = True
            continue
        if END_MARKER in line:
            in_block = False
            continue
        if not in_block:
            out.append(line)

    # Trim trailing empty lines
    while out and not out[-1].strip():
        out.pop()

    return "\n".join(out) + "\n"


RESERVED_DOMAINS = {
    "localhost",
    "broadcasthost",
    "local",
    "ip6-localhost",
    "ip6-loopback",
    "ip6-allnodes",
    "ip6-allrouters",
    "ip6-allhosts",
    "0.0.0.0",
    "255.255.255.255",
}


def ensure_backup():
    """Creates a backup of /etc/hosts if it doesn't already exist, strictly without following symlinks."""
    if os.path.lexists(BACKUP_PATH):
        if os.path.islink(BACKUP_PATH):
            try:
                os.unlink(BACKUP_PATH)
            except Exception as e:
                print(f"Fatal error: Could not remove symlink {BACKUP_PATH}: {e}", file=sys.stderr)
                sys.exit(1)
        else:
            return  # Clean backup already exists

    if not os.path.lexists(HOSTS_PATH):
        return
    if os.path.islink(HOSTS_PATH) or not os.path.isfile(HOSTS_PATH):
        print(f"Fatal error: {HOSTS_PATH} is a symlink or not a regular file. Aborting backup.", file=sys.stderr)
        sys.exit(1)

    try:
        flags_r = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        fd_r = os.open(HOSTS_PATH, flags_r)
        with open(fd_r, "r", encoding="utf-8", errors="ignore") as src:
            content = src.read(32 * 1024 * 1024)
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(BACKUP_PATH, flags, 0o644)
        with open(fd, "w", encoding="utf-8") as dst:
            dst.write(content)
    except FileExistsError:
        pass
    except Exception as e:
        print(f"Fatal error: Could not create backup {BACKUP_PATH}: {e}. Aborting to prevent data loss.", file=sys.stderr)
        sys.exit(1)


def get_status():
    """Checks if OmaBlock is currently active in /etc/hosts."""
    if not os.path.exists(HOSTS_PATH) or os.path.islink(HOSTS_PATH):
        print('{"active": false, "rule_count": 0}')
        return

    count = 0
    in_block = False
    try:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(HOSTS_PATH, flags)
        with open(fd, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                if BEGIN_MARKER in line:
                    in_block = True
                    continue
                if END_MARKER in line:
                    in_block = False
                    break
                if in_block and line.startswith("0.0.0.0 "):
                    count += 1
    except Exception:
        pass

    active = in_block or count > 0
    print(f'{{"active": {str(active).lower()}, "rule_count": {count}}}')


def apply_rules(rules_file: str):
    """Reads rules file, validates each domain, and injects into /etc/hosts."""
    if not os.path.exists(rules_file):
        print(f"Error: Rules file '{rules_file}' not found.", file=sys.stderr)
        sys.exit(1)

    # Security check: verify rules_file is a regular file, not a symlink, and within size limit
    try:
        st = os.lstat(rules_file)
        if os.path.islink(rules_file) or not os.path.isfile(rules_file):
            print(f"Security violation: Rules file '{rules_file}' must be a regular file, not a symlink.", file=sys.stderr)
            sys.exit(1)
        if st.st_size > 50 * 1024 * 1024:
            print(f"Security violation: Rules file '{rules_file}' exceeds maximum 50 MiB limit.", file=sys.stderr)
            sys.exit(1)
    except Exception as e:
        print(f"Security violation: Could not verify rules file '{rules_file}': {e}", file=sys.stderr)
        sys.exit(1)

    valid_domains = []
    MAX_DOMAINS = 500_000
    try:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(rules_file, flags)
        with open(fd, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue

                # Handle either "0.0.0.0 domain" or "domain"
                parts = line.split()
                if len(parts) >= 2 and parts[0] in ("0.0.0.0", "127.0.0.1"):
                    domain = parts[1].strip().lower()
                elif len(parts) == 1:
                    domain = parts[0].strip().lower()
                else:
                    continue

                # Strip port or trailing dot
                domain = domain.rstrip(".")
                if (
                    domain in RESERVED_DOMAINS
                    or "." not in domain
                    or domain.endswith((".local", ".localhost", ".lan", ".internal", ".arpa"))
                ):
                    continue

                # Validate domain format
                if DOMAIN_REGEX.match(domain):
                    valid_domains.append(domain)
                    if len(valid_domains) >= MAX_DOMAINS:
                        break
    except Exception as e:
        print(f"Error reading rules file '{rules_file}': {e}", file=sys.stderr)
        sys.exit(1)

    # Read current hosts
    content = ""
    if os.path.lexists(HOSTS_PATH):
        if os.path.islink(HOSTS_PATH) or not os.path.isfile(HOSTS_PATH):
            print(f"Fatal error: {HOSTS_PATH} is a symlink or not a regular file. Aborting.", file=sys.stderr)
            sys.exit(1)
        try:
            flags_r = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
            fd_r = os.open(HOSTS_PATH, flags_r)
            with open(fd_r, "r", encoding="utf-8") as f:
                content = f.read(32 * 1024 * 1024)
        except Exception as e:
            print(f"Fatal error: Could not read {HOSTS_PATH} completely: {e}. Aborting to prevent data loss.", file=sys.stderr)
            sys.exit(1)

    ensure_backup()
    clean_hosts = strip_omablock_block(content)

    # Prevent symlink pre-creation attack on TEMP_PATH
    if os.path.lexists(TEMP_PATH):
        try:
            os.unlink(TEMP_PATH)
        except OSError:
            pass

    # Stream write with O_NOFOLLOW directly to prevent huge memory allocations
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(TEMP_PATH, flags, 0o644)
        with open(fd, "w", encoding="utf-8") as f:
            f.write(clean_hosts)
            if not clean_hosts.endswith("\n"):
                f.write("\n")
            f.write(BEGIN_MARKER + "\n")
            f.write(BANNER_COMMENT + "\n")
            for d in valid_domains:
                f.write(f"0.0.0.0 {d}\n")
                if d in DOH_DOMAINS:
                    f.write(f":: {d}\n")
            f.write(END_MARKER + "\n")
        os.chmod(TEMP_PATH, 0o644)

        # Atomic swap
        os.replace(TEMP_PATH, HOSTS_PATH)
    except Exception as e:
        print(f"Fatal error: Failed to write or replace {HOSTS_PATH}: {e}", file=sys.stderr)
        if os.path.lexists(TEMP_PATH):
            try:
                os.unlink(TEMP_PATH)
            except OSError:
                pass
        sys.exit(1)

    apply_browser_doh_policy()
    flush_dns_cache()
    print(f"Applied {len(valid_domains)} OmaBlock rules to {HOSTS_PATH}.")


def apply_nftables_rules():
    """Applies kernel-level Netfilter rules for OmaBlock if nftables is available."""
    nft_bin = shutil.which("nft")
    if not nft_bin:
        return

    # Generate DoH/DoT drop table
    nft_script = """
table inet omablock {
    set bad_ipv4 {
        type ipv4_addr;
        flags interval;
        elements = { 1.1.1.1, 1.0.0.1, 8.8.8.8, 8.8.4.4, 9.9.9.9, 149.112.112.112 }
    }
    set bad_ipv6 {
        type ipv6_addr;
        flags interval;
        elements = { 2606:4700:4700::1111, 2606:4700:4700::1001, 2001:4860:4860::8888, 2001:4860:4860::8844, 2620:fe::fe }
    }
    chain output {
        type filter hook output priority filter; policy accept;
        # Restrict drops to encrypted DNS ports (443 DoH, 853 DoT, 53 plaintext) with fast TCP RST
        ip daddr @bad_ipv4 tcp dport { 443, 853 } counter reject with tcp reset
        ip daddr @bad_ipv4 udp dport { 53, 853 } counter reject with icmp type admin-prohibited
        ip6 daddr @bad_ipv6 tcp dport { 443, 853 } counter reject with tcp reset
        ip6 daddr @bad_ipv6 udp dport { 53, 853 } counter reject with icmpx type admin-prohibited
    }
}
"""
    tmp_nft = "/etc/hosts.omablock.nft.tmp"
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(tmp_nft, flags, 0o600)
        with open(fd, "w", encoding="utf-8") as f:
            f.write(nft_script)
        subprocess.run([nft_bin, "-f", tmp_nft], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    finally:
        if os.path.lexists(tmp_nft):
            try:
                os.unlink(tmp_nft)
            except OSError:
                pass


def clear_nftables_rules():
    """Flushes OmaBlock kernel Netfilter table if present."""
    nft_bin = shutil.which("nft")
    if not nft_bin:
        return
    subprocess.run([nft_bin, "delete", "table", "inet", "omablock"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)


def clear_rules():
    """Removes OmaBlock rules from /etc/hosts and kernel Netfilter table."""
    clear_nftables_rules()
    if not os.path.lexists(HOSTS_PATH):
        return
    if os.path.islink(HOSTS_PATH) or not os.path.isfile(HOSTS_PATH):
        print(f"Fatal error: {HOSTS_PATH} is a symlink or not a regular file. Aborting.", file=sys.stderr)
        sys.exit(1)

    content = ""
    try:
        flags_r = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        fd_r = os.open(HOSTS_PATH, flags_r)
        with open(fd_r, "r", encoding="utf-8") as f:
            content = f.read(32 * 1024 * 1024)
    except Exception as e:
        print(f"Fatal error: Could not read {HOSTS_PATH} completely: {e}. Aborting to prevent data loss.", file=sys.stderr)
        sys.exit(1)

    if BEGIN_MARKER not in content:
        flush_dns_cache()
        print("OmaBlock rules were not active.")
        return

    clean_hosts = strip_omablock_block(content)

    # Prevent symlink pre-creation attack on TEMP_PATH
    if os.path.lexists(TEMP_PATH):
        try:
            os.unlink(TEMP_PATH)
        except OSError:
            pass

    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(TEMP_PATH, flags, 0o644)
        with open(fd, "w", encoding="utf-8") as f:
            f.write(clean_hosts)
        os.chmod(TEMP_PATH, 0o644)

        os.replace(TEMP_PATH, HOSTS_PATH)
    except Exception as e:
        print(f"Fatal error: Failed to clear OmaBlock rules from {HOSTS_PATH}: {e}", file=sys.stderr)
        if os.path.lexists(TEMP_PATH):
            try:
                os.unlink(TEMP_PATH)
            except OSError:
                pass
        sys.exit(1)

    clear_browser_doh_policy()
    flush_dns_cache()
    print("Cleared OmaBlock rules from /etc/hosts.")


def main():
    if len(sys.argv) < 2:
        print("Usage: omablock-hosts-sync [--apply <rules_file> [--with-kernel] | --clear | --status]")
        sys.exit(1)

    cmd = sys.argv[1]
    if cmd == "--status":
        get_status()
    elif cmd == "--clear":
        if os.geteuid() != 0:
            print("Error: --clear requires root privileges.", file=sys.stderr)
            sys.exit(1)
        clear_rules()
    elif cmd == "--apply":
        if len(sys.argv) < 3:
            print("Error: Missing rules file path.", file=sys.stderr)
            sys.exit(1)
        if os.geteuid() != 0:
            print("Error: --apply requires root privileges.", file=sys.stderr)
            sys.exit(1)
        apply_rules(sys.argv[2])
        if "--with-kernel" in sys.argv:
            apply_nftables_rules()
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
