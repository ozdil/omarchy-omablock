#!/usr/bin/python3
# OmaBlock Official Privileged Hosts Sync Helper (ozdil.omablock)
# OMABLOCK_HELPER_SIGNATURE = "7f8b9e6a-omablock-hosts-sync-helper-v1"
"""
OmaBlock Hosts Sync Helper
Safely and atomically modifies /etc/hosts to apply or remove OmaBlock sinkhole rules.
Adheres strictly to the Omarchy Security Guide:
- Strict regex validation on domain entries (no shell injection, no arbitrary host overrides).
- Preserves all pre-existing system and user hosts entries.
- Atomic file replacement via os.replace to prevent race conditions or partial writes.
- Automatic DNS cache flush via resolvectl.
"""

import fcntl
import json
import os
import re
import sys
import shutil
import stat
import subprocess

HOSTS_PATH = "/etc/hosts"
BACKUP_PATH = "/etc/hosts.omablock.bak"
TEMP_PATH = "/etc/hosts.omablock.tmp"
MAX_HOSTS_SIZE = 128 * 1024 * 1024  # 128 MiB


def read_hosts_file(path: str = HOSTS_PATH) -> str:
    """Safely reads a hosts file strictly avoiding symlinks and size/truncation violations.
    Exits with code 1 immediately on any security or reading error."""
    if not os.path.lexists(path):
        return ""

    try:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(path, flags)
    except Exception as e:
        print(f"Fatal error: Could not open {path} (symlink or unreadable): {e}", file=sys.stderr)
        sys.exit(1)

    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            print(f"Fatal error: {path} is not a regular file.", file=sys.stderr)
            sys.exit(1)
        if st.st_size > MAX_HOSTS_SIZE:
            print(f"Fatal error: {path} exceeds maximum allowed size ({MAX_HOSTS_SIZE} bytes).", file=sys.stderr)
            sys.exit(1)

        # surrogateescape round-trips non-UTF-8 bytes instead of silently dropping them
        with open(fd, "r", encoding="utf-8", errors="surrogateescape") as f:
            content = f.read(MAX_HOSTS_SIZE)
            leftover = f.read(1)
            if leftover:
                print(f"Fatal error: {path} truncated or modified during read (exceeds {MAX_HOSTS_SIZE} bytes).", file=sys.stderr)
                sys.exit(1)
            return content
    except SystemExit:
        raise
    except Exception as e:
        print(f"Fatal error: Could not read {path}: {e}", file=sys.stderr)
        sys.exit(1)

BEGIN_MARKER = "# --- BEGIN OMABLOCK MANAGED RULES ---"
END_MARKER = "# --- END OMABLOCK MANAGED RULES ---"
BANNER_COMMENT = (
    "# Managed automatically by OmaBlock (ozdil.omablock). Do not edit inside this block."
)

# RFC 1035 domain regex: labels 1-63 chars starting/ending with alphanumeric, separated by single dots.
# Inner underscores are allowed (as in the engine's validate_domain) since real tracker hosts use them.
DOMAIN_REGEX = re.compile(
    r"^(?!-)(?:[a-zA-Z0-9](?:[a-zA-Z0-9_-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
)


POLICY_DIRS = [
    "/etc/opt/chrome/policies/managed",
    "/etc/chromium/policies/managed",
    "/etc/brave/policies/managed",
    "/etc/edge/policies/managed",
]
POLICY_FILENAME = "omablock_policies.json"
POLICY_MARKER = '"_omablock_managed": true'
POLICY_CONTENT = '{"_omablock_managed": true, "DnsOverHttpsMode": "off", "QuicAllowed": false}\n'

DOH_DOMAINS = {
    "use-application-dns.net",
    "dns.google",
    "dns.google.com",
    "cloudflare-dns.com",
    "chrome.cloudflare-dns.com",
    "mozilla.cloudflare-dns.com",
    "1dot1dot1dot1.cloudflare-dns.com",
    "dns.quad9.net",
    "doh.opendns.com",
    "dns.adguard-dns.com",
    "doh.cleanbrowsing.org",
    "dns.nextdns.io",
    "doh.applied-privacy.net",
    "dnsforge.de",
    "doh.mullvad.net",
    "doh.controld.com",
    "dns.alidns.com",
    "doh.pub",
    "dns.sb",
}


def apply_browser_doh_policy():
    """Enforces DnsOverHttpsMode: 'off' in browser enterprise policies so browsers cannot bypass /etc/hosts via DoH.
    Never overwrites pre-existing policies not created and owned by OmaBlock."""
    for pdir in POLICY_DIRS:
        parent = os.path.dirname(pdir)
        if (os.path.exists(parent) and not os.path.islink(parent)) or (os.path.exists(pdir) and not os.path.islink(pdir)):
            try:
                target = os.path.join(pdir, POLICY_FILENAME)
                if os.path.exists(target):
                    if os.path.islink(target):
                        continue
                    try:
                        with open(target, "r", encoding="utf-8") as existing_f:
                            existing_content = existing_f.read(1024)
                            if POLICY_MARKER not in existing_content:
                                # Preserve existing user policy; do not overwrite
                                continue
                    except Exception:
                        continue

                os.makedirs(pdir, mode=0o755, exist_ok=True)
                tmp = target + ".tmp"
                flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0)
                fd = os.open(tmp, flags, 0o644)
                with open(fd, "w", encoding="utf-8") as f:
                    f.write(POLICY_CONTENT)
                os.chmod(tmp, 0o644)
                os.replace(tmp, target)
            except Exception as e:
                print(f"Warning: Could not write browser DoH policy in {pdir}: {e}", file=sys.stderr)


def clear_browser_doh_policy():
    """Removes OmaBlock DoH policy strictly if created and owned by OmaBlock."""
    for pdir in POLICY_DIRS:
        target = os.path.join(pdir, POLICY_FILENAME)
        if os.path.exists(target) and not os.path.islink(target):
            try:
                with open(target, "r", encoding="utf-8") as f:
                    content = f.read(1024)
                    if POLICY_MARKER not in content:
                        # Not an OmaBlock managed policy, preserve it
                        continue
                os.unlink(target)
            except Exception:
                pass


def flush_dns_cache():
    """Flushes systemd-resolved DNS cache if available."""
    try:
        subprocess.run(
            ["resolvectl", "flush-caches"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=10,
        )
    except Exception:
        pass


def strip_omablock_block(content: str) -> str:
    """Removes any existing OmaBlock block from hosts content."""
    # split("\n") instead of splitlines(): the latter also breaks on \x0c, \x1c, \u2028...
    lines = content.split("\n")
    out = []
    block = []
    in_block = False

    for line in lines:
        if BEGIN_MARKER in line:
            in_block = True
            block = []
            continue
        if END_MARKER in line:
            in_block = False
            block = []
            continue
        if in_block:
            block.append(line)
        else:
            out.append(line)

    # A BEGIN without a matching END (e.g. a hand edit) must not swallow user
    # entries that follow it: keep everything except our own sinkhole lines.
    if in_block:
        out.extend(
            line for line in block
            if line.strip() != BANNER_COMMENT
            and not line.startswith(("0.0.0.0 ", ":: "))
        )

    # Trim trailing empty lines
    while out and not out[-1].strip():
        out.pop()

    return "\n".join(out) + "\n"


RESERVED_DOMAINS = {
    "localhost",
    "broadcasthost",
    "local",
    "ip6-localhost",
    "ip6-loopback",
    "ip6-allnodes",
    "ip6-allrouters",
    "ip6-allhosts",
    "0.0.0.0",
    "255.255.255.255",
}


def fsync_dir(path: str):
    """Flushes a directory entry so a completed os.replace survives a crash."""
    try:
        dfd = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    except OSError:
        return
    try:
        os.fsync(dfd)
    except OSError:
        pass
    finally:
        os.close(dfd)


def copy_hosts_metadata(tmp_path: str):
    """Gives the replacement file the current hosts file's mode and owner (0644 root if absent)."""
    mode, uid, gid = 0o644, None, None
    try:
        st = os.lstat(HOSTS_PATH)
        if stat.S_ISREG(st.st_mode):
            mode, uid, gid = stat.S_IMODE(st.st_mode), st.st_uid, st.st_gid
    except FileNotFoundError:
        pass
    os.chmod(tmp_path, mode)
    if uid is not None and (uid, gid) != (os.geteuid(), os.getegid()):
        os.chown(tmp_path, uid, gid, follow_symlinks=False)


def acquire_helper_lock():
    """Serialises concurrent helper runs so apply/clear/blackout cannot interleave."""
    if os.path.islink(KERNEL_STATE_DIR):
        print(f"Fatal error: {KERNEL_STATE_DIR} is a symlink.", file=sys.stderr)
        sys.exit(1)
    os.makedirs(KERNEL_STATE_DIR, mode=0o755, exist_ok=True)
    fd = os.open(
        os.path.join(KERNEL_STATE_DIR, "helper.lock"),
        os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0),
        0o600,
    )
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def ensure_backup():
    """Creates a backup of /etc/hosts if it doesn't already exist, strictly without following symlinks."""
    if os.path.lexists(BACKUP_PATH):
        if os.path.islink(BACKUP_PATH):
            try:
                os.unlink(BACKUP_PATH)
            except Exception as e:
                print(f"Fatal error: Could not remove symlink {BACKUP_PATH}: {e}", file=sys.stderr)
                sys.exit(1)
        else:
            return  # Clean backup already exists

    if not os.path.lexists(HOSTS_PATH):
        return

    content = read_hosts_file(HOSTS_PATH)
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(BACKUP_PATH, flags, 0o644)
        with open(fd, "w", encoding="utf-8", errors="surrogateescape") as dst:
            dst.write(content)
    except FileExistsError:
        pass
    except Exception as e:
        print(f"Fatal error: Could not create backup {BACKUP_PATH}: {e}. Aborting to prevent data loss.", file=sys.stderr)
        sys.exit(1)


def get_status():
    """Checks if OmaBlock is currently active in /etc/hosts."""
    if not os.path.exists(HOSTS_PATH) or os.path.islink(HOSTS_PATH):
        print('{"active": false, "rule_count": 0}')
        return

    count = 0
    in_block = False
    try:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(HOSTS_PATH, flags)
        with open(fd, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                if BEGIN_MARKER in line:
                    in_block = True
                    continue
                if END_MARKER in line:
                    in_block = False
                    break
                if in_block and line.startswith("0.0.0.0 "):
                    count += 1
    except Exception:
        pass

    active = count > 0
    print(f'{{"active": {str(active).lower()}, "rule_count": {count}}}')


def apply_rules(rules_file: str):
    """Reads rules file, validates each domain, and injects into /etc/hosts."""
    if not os.path.exists(rules_file):
        print(f"Error: Rules file '{rules_file}' not found.", file=sys.stderr)
        sys.exit(1)

    # Security check: verify rules_file is a regular file, not a symlink, and within size limit
    try:
        st = os.lstat(rules_file)
        if os.path.islink(rules_file) or not os.path.isfile(rules_file):
            print(f"Security violation: Rules file '{rules_file}' must be a regular file, not a symlink.", file=sys.stderr)
            sys.exit(1)
        if st.st_size > 50 * 1024 * 1024:
            print(f"Security violation: Rules file '{rules_file}' exceeds maximum 50 MiB limit.", file=sys.stderr)
            sys.exit(1)
    except Exception as e:
        print(f"Security violation: Could not verify rules file '{rules_file}': {e}", file=sys.stderr)
        sys.exit(1)

    valid_domains = []
    MAX_DOMAINS = 500_000
    try:
        # O_NONBLOCK keeps a FIFO swapped in after the lstat check from hanging the helper;
        # fstat on the opened fd is the check that actually counts.
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
        fd = os.open(rules_file, flags)
        fst = os.fstat(fd)
        if not stat.S_ISREG(fst.st_mode) or fst.st_size > 50 * 1024 * 1024:
            os.close(fd)
            print(f"Security violation: Rules file '{rules_file}' changed during verification.", file=sys.stderr)
            sys.exit(1)
        with open(fd, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue

                # Handle either "0.0.0.0 domain" or "domain"
                parts = line.split()
                if len(parts) >= 2 and parts[0] in ("0.0.0.0", "127.0.0.1"):
                    domain = parts[1].strip().lower()
                elif len(parts) == 1:
                    domain = parts[0].strip().lower()
                else:
                    continue

                # Strip port or trailing dot
                domain = domain.rstrip(".")
                if (
                    domain in RESERVED_DOMAINS
                    or "." not in domain
                    or domain.endswith((".local", ".localhost", ".localdomain", ".lan", ".internal", ".arpa", ".test", ".invalid"))
                ):
                    continue

                # Validate domain format
                if DOMAIN_REGEX.match(domain):
                    valid_domains.append(domain)
                    if len(valid_domains) >= MAX_DOMAINS:
                        break
    except Exception as e:
        print(f"Error reading rules file '{rules_file}': {e}", file=sys.stderr)
        sys.exit(1)

    # Read current hosts
    content = read_hosts_file(HOSTS_PATH)

    ensure_backup()
    clean_hosts = strip_omablock_block(content)

    # Prevent symlink pre-creation attack on TEMP_PATH
    if os.path.lexists(TEMP_PATH):
        try:
            os.unlink(TEMP_PATH)
        except OSError:
            pass

    # Stream write with O_NOFOLLOW directly to prevent huge memory allocations
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(TEMP_PATH, flags, 0o644)
        with open(fd, "w", encoding="utf-8", errors="surrogateescape") as f:
            f.write(clean_hosts)
            if not clean_hosts.endswith("\n"):
                f.write("\n")
            f.write(BEGIN_MARKER + "\n")
            f.write(BANNER_COMMENT + "\n")
            for d in valid_domains:
                f.write(f"0.0.0.0 {d}\n")
                if d in DOH_DOMAINS:
                    f.write(f":: {d}\n")
            f.write(END_MARKER + "\n")
            f.flush()
            os.fsync(f.fileno())
        copy_hosts_metadata(TEMP_PATH)

        # Atomic swap
        os.replace(TEMP_PATH, HOSTS_PATH)
        fsync_dir(os.path.dirname(HOSTS_PATH) or ".")
    except Exception as e:
        print(f"Fatal error: Failed to write or replace {HOSTS_PATH}: {e}", file=sys.stderr)
        if os.path.lexists(TEMP_PATH):
            try:
                os.unlink(TEMP_PATH)
            except OSError:
                pass
        sys.exit(1)

    apply_browser_doh_policy()
    flush_dns_cache()
    print(f"Applied {len(valid_domains)} OmaBlock rules to {HOSTS_PATH}.")


# nft needs CAP_NET_ADMIN, so the unprivileged engine cannot query it. The helper
# records what it installed here (tmpfs, world-readable, gone after reboot just
# like the nft tables themselves) and the engine reads it for its status output.
KERNEL_STATE_DIR = "/run/omablock"
KERNEL_STATE_FILE = "kernel_state.json"
KERNEL_TABLE = "omablock"
BLACKOUT_TABLE = "omablock_blackout"

BLACKOUT_SCRIPT = """
table inet omablock_blackout
delete table inet omablock_blackout
table inet omablock_blackout {
    chain output {
        type filter hook output priority filter; policy accept;
        # Reject non-loopback DNS (53, 853). Locally generated packets have no input
        # interface, so the loopback exemption must match on oifname.
        oifname != "lo" tcp dport { 53, 853 } counter reject with tcp reset
        oifname != "lo" udp dport { 53, 853 } counter reject with icmpx type admin-prohibited
    }
}
"""


def run_nft_script(nft_bin: str, script: str) -> bool:
    """Feeds an nft script on stdin (no temp file to race on)."""
    try:
        proc = subprocess.run(
            [nft_bin, "-f", "-"],
            input=script,
            text=True,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        return proc.returncode == 0
    except Exception:
        return False


def nft_table_rule_count(nft_bin, table: str):
    """Returns the number of reject rules in an inet table, or None if it does not exist."""
    if not nft_bin:
        return None
    try:
        proc = subprocess.run(
            [nft_bin, "list", "table", "inet", table],
            check=False,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except Exception:
        return None
    if proc.returncode != 0:
        return None
    return sum(1 for line in proc.stdout.splitlines() if " reject" in line)


def write_kernel_state():
    """Publishes the current nft state for the unprivileged engine."""
    nft_bin = shutil.which("nft")
    kernel_rules = nft_table_rule_count(nft_bin, KERNEL_TABLE)
    blackout_rules = nft_table_rule_count(nft_bin, BLACKOUT_TABLE)
    state = {
        "nft_available": bool(nft_bin),
        "kernel_active": kernel_rules is not None,
        "kernel_rule_count": kernel_rules or 0,
        "blackout_active": blackout_rules is not None,
    }
    try:
        if os.path.islink(KERNEL_STATE_DIR):
            print(f"Warning: {KERNEL_STATE_DIR} is a symlink; not writing kernel state.", file=sys.stderr)
            return
        os.makedirs(KERNEL_STATE_DIR, mode=0o755, exist_ok=True)
        target = os.path.join(KERNEL_STATE_DIR, KERNEL_STATE_FILE)
        tmp = target + ".tmp"
        if os.path.lexists(tmp):
            os.unlink(tmp)
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644)
        with open(fd, "w", encoding="utf-8") as f:
            json.dump(state, f)
        os.chmod(tmp, 0o644)
        os.replace(tmp, target)
    except Exception as e:
        print(f"Warning: Could not write kernel state: {e}", file=sys.stderr)


def apply_blackout() -> bool:
    nft_bin = shutil.which("nft")
    if not nft_bin:
        print("Error: nft is not installed.", file=sys.stderr)
        return False
    return run_nft_script(nft_bin, BLACKOUT_SCRIPT)


def clear_blackout():
    nft_bin = shutil.which("nft")
    if not nft_bin:
        return
    subprocess.run([nft_bin, "delete", "table", "inet", BLACKOUT_TABLE], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)


def apply_nftables_rules():
    """Applies kernel-level Netfilter rules for OmaBlock if nftables is available."""
    nft_bin = shutil.which("nft")
    if not nft_bin:
        return

    # Generate DoH/DoT drop table
    # Declaring then deleting the table first makes `nft -f` replace it atomically;
    # without this every apply appends a second copy of the chain rules.
    nft_script = """
table inet omablock
delete table inet omablock
table inet omablock {
    set bad_ipv4 {
        type ipv4_addr;
        flags interval;
        elements = { 1.1.1.1, 1.0.0.1, 8.8.8.8, 8.8.4.4, 9.9.9.9, 149.112.112.112 }
    }
    set bad_ipv6 {
        type ipv6_addr;
        flags interval;
        elements = { 2606:4700:4700::1111, 2606:4700:4700::1001, 2001:4860:4860::8888, 2001:4860:4860::8844, 2620:fe::fe }
    }
    chain output {
        type filter hook output priority filter; policy accept;
        # Restrict drops to encrypted DNS ports (443 DoH, 853 DoT, 53 plaintext) with fast TCP RST
        ip daddr @bad_ipv4 tcp dport { 443, 853 } counter reject with tcp reset
        ip daddr @bad_ipv4 udp dport { 53, 853 } counter reject with icmp type admin-prohibited
        ip6 daddr @bad_ipv6 tcp dport { 443, 853 } counter reject with tcp reset
        ip6 daddr @bad_ipv6 udp dport { 53, 853 } counter reject with icmpx type admin-prohibited
    }
}
"""
    run_nft_script(nft_bin, nft_script)


def clear_nftables_rules():
    """Flushes OmaBlock kernel Netfilter table if present."""
    nft_bin = shutil.which("nft")
    if not nft_bin:
        return
    subprocess.run([nft_bin, "delete", "table", "inet", "omablock"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)


def clear_rules():
    """Removes OmaBlock rules from /etc/hosts and kernel Netfilter table."""
    clear_nftables_rules()
    # Browser DoH policies are independent of the hosts block; always remove them.
    clear_browser_doh_policy()
    if not os.path.lexists(HOSTS_PATH):
        return

    content = read_hosts_file(HOSTS_PATH)

    if BEGIN_MARKER not in content:
        flush_dns_cache()
        print("OmaBlock rules were not active.")
        return

    clean_hosts = strip_omablock_block(content)

    # Prevent symlink pre-creation attack on TEMP_PATH
    if os.path.lexists(TEMP_PATH):
        try:
            os.unlink(TEMP_PATH)
        except OSError:
            pass

    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(TEMP_PATH, flags, 0o644)
        with open(fd, "w", encoding="utf-8", errors="surrogateescape") as f:
            f.write(clean_hosts)
            f.flush()
            os.fsync(f.fileno())
        copy_hosts_metadata(TEMP_PATH)

        os.replace(TEMP_PATH, HOSTS_PATH)
        fsync_dir(os.path.dirname(HOSTS_PATH) or ".")
    except Exception as e:
        print(f"Fatal error: Failed to clear OmaBlock rules from {HOSTS_PATH}: {e}", file=sys.stderr)
        if os.path.lexists(TEMP_PATH):
            try:
                os.unlink(TEMP_PATH)
            except OSError:
                pass
        sys.exit(1)

    flush_dns_cache()
    print("Cleared OmaBlock rules from /etc/hosts.")


def require_root(cmd: str):
    if os.geteuid() != 0:
        print(f"Error: {cmd} requires root privileges.", file=sys.stderr)
        sys.exit(1)


PRE_RESTORE_PATH = "/etc/hosts.omablock.pre-restore"


def write_hosts_atomically(content: str):
    """Writes content to HOSTS_PATH through TEMP_PATH with fsync and the original metadata."""
    if os.path.lexists(TEMP_PATH):
        os.unlink(TEMP_PATH)
    fd = os.open(TEMP_PATH, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644)
    try:
        with open(fd, "w", encoding="utf-8", errors="surrogateescape") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        copy_hosts_metadata(TEMP_PATH)
        os.replace(TEMP_PATH, HOSTS_PATH)
        fsync_dir(os.path.dirname(HOSTS_PATH) or ".")
    except Exception:
        if os.path.lexists(TEMP_PATH):
            os.unlink(TEMP_PATH)
        raise


def restore_backup():
    """Puts back the /etc/hosts saved before OmaBlock first touched it.
    The current file is kept as PRE_RESTORE_PATH, and any OmaBlock block is stripped."""
    if not os.path.lexists(BACKUP_PATH) or os.path.islink(BACKUP_PATH):
        print(f"Error: no usable backup at {BACKUP_PATH}.", file=sys.stderr)
        sys.exit(1)
    backup = read_hosts_file(BACKUP_PATH)
    current = read_hosts_file(HOSTS_PATH)
    try:
        if os.path.lexists(PRE_RESTORE_PATH):
            os.unlink(PRE_RESTORE_PATH)
        fd = os.open(PRE_RESTORE_PATH, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644)
        with open(fd, "w", encoding="utf-8", errors="surrogateescape") as f:
            f.write(current)
        write_hosts_atomically(strip_omablock_block(backup))
    except Exception as e:
        print(f"Fatal error: could not restore {HOSTS_PATH}: {e}", file=sys.stderr)
        sys.exit(1)
    clear_nftables_rules()
    clear_browser_doh_policy()
    flush_dns_cache()
    print(f"Restored {HOSTS_PATH} from {BACKUP_PATH}; previous file kept at {PRE_RESTORE_PATH}.")


def main():
    if len(sys.argv) < 2:
        print("Usage: omablock-hosts-sync [--apply <rules_file> [--with-kernel] | --clear | --status | --blackout-on | --blackout-off | --restore-backup]")
        sys.exit(1)

    cmd = sys.argv[1]
    if cmd in ("--apply", "--clear", "--blackout-on", "--blackout-off", "--restore-backup") and os.geteuid() == 0:
        _lock_fd = acquire_helper_lock()  # held until the process exits
    if cmd == "--status":
        get_status()
    elif cmd == "--clear":
        if os.geteuid() != 0:
            print("Error: --clear requires root privileges.", file=sys.stderr)
            sys.exit(1)
        clear_rules()
        write_kernel_state()
    elif cmd == "--restore-backup":
        require_root(cmd)
        restore_backup()
        write_kernel_state()
    elif cmd == "--blackout-on":
        require_root(cmd)
        ok = apply_blackout()
        write_kernel_state()
        if not ok:
            print("Error: Failed to apply network blackout.", file=sys.stderr)
            sys.exit(1)
        print("Network blackout applied.")
    elif cmd == "--blackout-off":
        require_root(cmd)
        clear_blackout()
        write_kernel_state()
        print("Network blackout cleared.")
    elif cmd == "--apply":
        if len(sys.argv) < 3:
            print("Error: Missing rules file path.", file=sys.stderr)
            sys.exit(1)
        if os.geteuid() != 0:
            print("Error: --apply requires root privileges.", file=sys.stderr)
            sys.exit(1)
        apply_rules(sys.argv[2])
        if "--with-kernel" in sys.argv:
            apply_nftables_rules()
        else:
            # Kernel enforcement was switched off: drop any table left from a previous apply.
            clear_nftables_rules()
        write_kernel_state()
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
